// Prisma schema for Gravitas Edge Consulting job platform
// Run: npx prisma migrate dev / npx prisma db push
// Generated client is placed in apps/api/node_modules/.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================================
// ENUMS
// PostgreSQL-native enum types for domain statuses across the platform.
// ==========================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VaultStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VaultType {
  INDIA
  GLOBAL
  MIDDLE_EAST
  INTERNATIONAL
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
  FAILED
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  EXPIRED
}

enum OpportunityCategory {
  INDIA
  GLOBAL
  MIDDLE_EAST
  INTERNATIONAL
  OTHER
}

enum RecruitmentVendorCategory {
  VENDOR_ENABLEMENT
  RFP_EOI_RFQ
  STAFFING_RPO
  EXECUTIVE_SEARCH
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  REMOTE
  HYBRID
  OTHER
}

enum ReferralStatus {
  PENDING
  SUCCESSFUL
  INVALID
  SUSPENDED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

enum ResumeUploadStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ResumeProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  OCR_REQUIRED
  OCR_COMPLETED
  ERROR
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum ProfileConfirmationStatus {
  EXTRACTED
  CONFIRMED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum SourceType {
  EXTRACTED
  USER_CONFIRMED
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

// ==========================================================================
// USERS & AUTHORIZATION
// ==========================================================================

model User {
  id                    String     @id @default(uuid())
  email                 String
  phone                 String?
  passwordHash          String?
  status                UserStatus @default(ACTIVE)
  emailVerified         Boolean    @default(false)
  referralCode          String?    @unique
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?
  passwordResetToken    String?
  passwordResetExpiresAt DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  roles              UserRole[]
  profile            UserProfile?
  subscriptions      Subscription[]
  ledReferrals       Referral[]         @relation("ReferralReferrer")
  receivedReferrals  Referral[]         @relation("ReferralReferred")
  opportunitiesOwned Opportunity[]
  resumes            Resume[]
  candidateProfiles  CandidateProfile[]
  payments           Payment[]
  couponAccess       CouponUser[]
  couponUsages       CouponUsage[]
  recruitmentVendorSubscriptions RecruitmentVendorSubscription[]
  recruitmentVendorCouponAccess  RecruitmentVendorCouponUser[]
  recruitmentVendorCouponUsages  RecruitmentVendorCouponUsage[]
  recruitmentVendorOpportunitiesOwned RecruitmentVendorOpportunity[]
  recruitmentVendorEnrollment RecruitmentVendorEnrollment?
  adminAuditLogs     AuditLog[]         @relation("AuditAdminUser")
  actionAuditLogs    AuditLog[]         @relation("AuditActorUser")

  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([deletedAt])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]

  @@index([name])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([userId])
}

model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  fullName          String?
  phone             String?
  location          String?
  yearsExperience   Int?
  monthsExperience  Int?
  currentJobTitle   String?
  currentCompany    String?
  profileImg        String?
  skills            Json?
  education         Json?
  workExperience    Json?
  certifications    Json?
  careerPreferences Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================================================
// VAULTS & EXPERIENCE ACCESS LEVELS
// ==========================================================================

model Vault {
  id          String      @id @default(uuid())
  name        String
  description String?
  status      VaultStatus @default(ACTIVE)
  type        VaultType   @default(OTHER)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  plans              PlanVault[]
  opportunities      OpportunityVault[]
  experienceLevels   VaultExperienceLevel[]
  subscriptionAccess SubscriptionVaultAccess[]

  @@unique([name])
  @@index([status])
  @@index([type])
  @@index([deletedAt])
}

model ExperienceLevel {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  code        String   @unique
  minYears    Int
  maxYears    Int?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vaults        VaultExperienceLevel[]
  opportunities OpportunityExperienceLevel[]

  @@index([slug])
  @@index([code])
}

model VaultExperienceLevel {
  id                String @id @default(uuid())
  vaultId           String
  experienceLevelId String

  vault           Vault           @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  experienceLevel ExperienceLevel @relation(fields: [experienceLevelId], references: [id], onDelete: Cascade)

  @@unique([vaultId, experienceLevelId])
  @@index([experienceLevelId])
}

// ==========================================================================
// SUBSCRIPTION PLANS
// ==========================================================================

model SubscriptionPlan {
  id              String    @id @default(uuid())
  name            String    @unique
  description     String?
  price           Decimal   @db.Decimal(10, 2)
  regularPrice    Decimal   @default(0) @db.Decimal(10, 2)
  discountPercentage Int    @default(0)
  currency        String    @default("INR")
  durationDays    Int
  isActive        Boolean   @default(true)
  razorpayPlanId  String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  vaults              PlanVault[]
  subscriptions       Subscription[]
  couponPlans         CouponPlan[]
  couponUsages        CouponUsage[]

  @@index([isActive])
  @@index([deletedAt])
  @@index([razorpayPlanId])
}

model PlanVault {
  id      String @id @default(uuid())
  planId  String
  vaultId String

  plan  SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  vault Vault            @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@unique([planId, vaultId])
  @@index([vaultId])
}

// ==========================================================================
// SUBSCRIPTIONS
// ==========================================================================

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String
  planId                 String
  startDate              DateTime
  endDate                DateTime
  status                 SubscriptionStatus @default(PENDING)
  paymentReference       String?
  razorpaySubscriptionId String?            @unique
  cancelledAt            DateTime?
  cancellationReason     String?
  autoRenew              Boolean            @default(false)
  nextBillingDate        DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  vaultAccess SubscriptionVaultAccess[]
  payments    Payment[]
  commissions ReferralCommission[]
  couponUsages CouponUsage[]

  @@unique([userId, planId, startDate])
  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
  @@index([razorpaySubscriptionId])
  @@index([userId, status, endDate])
  @@index([nextBillingDate])
}

model SubscriptionVaultAccess {
  id             String @id @default(uuid())
  subscriptionId String
  vaultId        String

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  vault        Vault        @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, vaultId])
  @@index([vaultId])
}

// ==========================================================================
// COUPONS
// ==========================================================================
//
// A coupon is either available to ALL users or to an explicit allow-list of
// specific users (there is no separate "one user" type - a single-entry
// allow-list is just the specific-users case with one user).
//
// `CouponUsage` is written inside the same transaction that creates the
// payment session, so usage limits are enforced atomically against
// simultaneous requests (the coupon row is locked with SELECT ... FOR UPDATE
// first). A usage only keeps counting towards the limits while its payment is
// still viable (CREATED/PENDING/SUCCESS); refunded/failed/cancelled payments
// release the slot.

model Coupon {
  id                String              @id @default(uuid())
  code              String              @unique // stored trimmed + upper-cased; lookups are case-insensitive
  description       String?
  discountType      CouponDiscountType
  discountValue     Decimal             @db.Decimal(10, 2)
  validFrom         DateTime
  validUntil        DateTime
  usageLimit        Int? // null = unlimited redemptions
  perUserUsageLimit Int                 @default(1)
  appliesToAllUsers Boolean             @default(true)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  plans  CouponPlan[]
  users  CouponUser[]
  usages CouponUsage[]

  @@index([isActive])
  @@index([deletedAt])
  @@index([validUntil])
}

// Applicable plans. An empty set means the coupon applies to every plan.
model CouponPlan {
  id       String @id @default(uuid())
  couponId String
  planId   String

  coupon Coupon           @relation(fields: [couponId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([couponId, planId])
  @@index([planId])
}

// Allow-list of users for `appliesToAllUsers = false` coupons.
model CouponUser {
  id       String @id @default(uuid())
  couponId String
  userId   String

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
}

// One row per redemption. Captures the full server-calculated price
// breakdown plus the purchase/subscription references for auditing.
model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String
  userId         String
  planId         String
  paymentId      String   @unique // one usage per payment session (double-spend guard)
  subscriptionId String?
  recruitmentVendorSubscriptionId String?
  originalAmount Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @db.Decimal(12, 2)
  finalAmount    Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR")
  usedAt         DateTime @default(now())

  coupon       Coupon           @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment      Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  subscription                Subscription?                @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  recruitmentVendorSubscription RecruitmentVendorSubscription? @relation(fields: [recruitmentVendorSubscriptionId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
  @@index([couponId, userId])
  @@index([planId])
  @@index([subscriptionId])
  @@index([recruitmentVendorSubscriptionId])
  @@index([usedAt])
}

// ==========================================================================
// OPPORTUNITIES
// ==========================================================================

model Opportunity {
  id                 String              @id @default(uuid())
  title              String
  description        String?
  qualification      String?
  company            String?
  location           String?
  country            String?
  employmentType     EmploymentType?
  industry           String?
  functionalArea     String?
  minExperience      Int?
  maxExperience      Int?
  applicationUrl     String?
  applicationContact String?
  source             String?
  salary             String?
  experienceText     String?
  externalRef        String?
  // Human-facing unique job identifier supplied by admins or the import file.
  // Nullable for backward compatibility: grandfathered rows keep no Job ID
  // until one is provided. The unique index allows multiple NULLs in Postgres.
  jobId              String?             @unique
  // Auto-assigned, database-wide display serial ("S. No."). Assigned by a
  // Postgres sequence on insert so the number is stable and never reused;
  // existing rows were backfilled in `createdAt` order by its migration.
  serialNo           Int                 @unique @default(autoincrement())
  category           OpportunityCategory @default(OTHER)
  status             OpportunityStatus   @default(DRAFT)
  createdBy          String?
  publishedDate      DateTime?
  expiryDate         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  creator          User?                        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  vaults           OpportunityVault[]
  experienceLevels OpportunityExperienceLevel[]

  @@index([status])
  @@index([category])
  @@index([location])
  @@index([country])
  @@index([industry])
  @@index([publishedDate])
  @@index([expiryDate])
  @@index([deletedAt])
  @@index([status, category, expiryDate])
}

model OpportunityVault {
  id            String @id @default(uuid())
  opportunityId String
  vaultId       String

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  vault       Vault       @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, vaultId])
  @@index([vaultId])
}

model OpportunityExperienceLevel {
  id                String @id @default(uuid())
  opportunityId     String
  experienceLevelId String

  opportunity     Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  experienceLevel ExperienceLevel @relation(fields: [experienceLevelId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, experienceLevelId])
  @@index([experienceLevelId])
}

// ==========================================================================
// REFERRALS, COMMISSIONS & SLABS
// ==========================================================================

model Referral {
  id              String         @id @default(uuid())
  referrerId      String
  referredUserId  String
  code            String
  referralLink    String?
  status          ReferralStatus @default(PENDING)
  successfulDate  DateTime?
  invalidReason   String?
  suspendedReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  referrer     User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  commissions ReferralCommission[]

  // A user cannot refer themselves.
  @@unique([referrerId, referredUserId])
  @@index([referrerId])
  @@index([referredUserId])
  @@index([status])
  @@index([code])
  @@index([deletedAt])
}

model ReferralCommission {
  id                   String           @id @default(uuid())
  referralId           String           @unique
  subscriptionId       String?
  commissionPercentage Decimal          @db.Decimal(5, 2)
  commissionAmount     Decimal          @db.Decimal(12, 2)
  subscriptionAmount   Decimal          @db.Decimal(12, 2)
  status               CommissionStatus @default(PENDING)
  approvedDate         DateTime?
  paidDate             DateTime?
  payoutReference      String?
  rejectedReason       String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  referral     Referral      @relation(fields: [referralId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // Prevent duplicate commission for the same qualifying subscription/payment.
  @@unique([subscriptionId])
  @@index([status])
  @@index([referralId])
  @@index([subscriptionId])
}

model ReferralSlab {
  id                   String   @id @default(uuid())
  minReferrals         Int
  maxReferrals         Int?
  commissionPercentage Decimal  @db.Decimal(5, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Each slab starts at a unique minimum referral count; the maximum bound is
  // open-ended (null) for the top slab. Ranges must not overlap (enforced at
  // the application layer; the unique min bound keeps the key safe).
  @@unique([minReferrals])
  @@index([isActive])
}

// ==========================================================================
// RESUMES & PROCESSING
// ==========================================================================

// Single resume store for both authenticated users and guest uploads.
// - userId set  → uploaded by a logged-in user
// - userId null → guest upload; `guestTokenHash` (sha256 of an opaque token
//   handed to the visitor once) is the only guest handle. On signup the same
//   row is linked by setting userId — no duplicate row is created.
model Resume {
  id              String             @id @default(uuid())
  userId          String?
  fullName        String?
  email           String?
  phone           String?
  guestTokenHash  String?            @unique
  originalName    String
  storageName     String
  fileType        String
  fileSize        Int
  storageProvider String             @default("local")
  storagePath     String
  storageKey      String?
  uploadStatus    ResumeUploadStatus @default(UPLOADED)
  uploadedAt      DateTime           @default(now())
  processedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  processing       ResumeProcessing?
  candidateProfile CandidateProfile?

  @@index([userId])
  @@index([email])
  @@index([uploadStatus])
  @@index([deletedAt])
}

model ResumeProcessing {
  id            String                 @id @default(uuid())
  resumeId      String                 @unique
  status        ResumeProcessingStatus @default(UPLOADED)
  startedAt     DateTime?
  completedAt   DateTime?
  errorMessage  String?
  parserVersion String?
  ocrUsed       Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([ocrUsed])
}

// ==========================================================================
// CANDIDATE PROFILE (from parsed resume + user confirmation)
// ==========================================================================

model CandidateProfile {
  id                 String                    @id @default(uuid())
  userId             String
  resumeId           String                    @unique
  fullName           String?
  email              String?
  phone              String?
  location           String?
  totalExperience    Int?
  currentJobTitle    String?
  currentCompany     String?
  resumeText         String?
  confirmationStatus ProfileConfirmationStatus @default(EXTRACTED)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  skills          CandidateSkill[]
  workExperience  CandidateWorkExperience[]
  education       CandidateEducation[]
  certifications  CandidateCertification[]
  industries      CandidateIndustry[]
  functionalAreas CandidateFunctionalArea[]

  @@index([userId])
  @@index([confirmationStatus])
}

model CandidateSkill {
  id                 String     @id @default(uuid())
  candidateProfileId String
  name               String
  source             SourceType @default(EXTRACTED)
  createdAt          DateTime   @default(now())

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([candidateProfileId, name])
  @@index([name])
}

model CandidateWorkExperience {
  id                 String     @id @default(uuid())
  candidateProfileId String
  company            String
  jobTitle           String?
  startDate          DateTime?
  endDate            DateTime?
  isCurrent          Boolean    @default(false)
  source             SourceType @default(EXTRACTED)
  createdAt          DateTime   @default(now())

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
}

model CandidateEducation {
  id                 String     @id @default(uuid())
  candidateProfileId String
  qualification      String
  institution        String?
  startYear          Int?
  endYear            Int?
  source             SourceType @default(EXTRACTED)
  createdAt          DateTime   @default(now())

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
}

model CandidateCertification {
  id                 String     @id @default(uuid())
  candidateProfileId String
  name               String
  issuer             String?
  issueYear          Int?
  source             SourceType @default(EXTRACTED)
  createdAt          DateTime   @default(now())

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
}

model CandidateIndustry {
  id                 String     @id @default(uuid())
  candidateProfileId String
  name               String
  source             SourceType @default(EXTRACTED)
  createdAt          DateTime   @default(now())

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([candidateProfileId, name])
  @@index([name])
}

model CandidateFunctionalArea {
  id                 String     @id @default(uuid())
  candidateProfileId String
  name               String
  source             SourceType @default(EXTRACTED)
  createdAt          DateTime   @default(now())

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([candidateProfileId, name])
  @@index([name])
}

// ==========================================================================


// ==========================================================================
// RECRUITMENT VENDOR ACCESS (RVA)
// A completely separate vault vertical. Reuse User/auth where appropriate,
// but subscriptions, opportunities, plans, entitlements, payments, FAQs,
// audits remain independently identifiable.
// ==========================================================================

enum RecruitmentVendorOpportunityStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  EXPIRED
}

model RecruitmentVendorOpportunity {
  id                 String                             @id @default(uuid())
  // Excel "S. No." display serial supplied by the source workbook. Nullable so
  // pre-existing rows (and rows without a serial) remain valid.
  serialNo           Int?
  title              String
  description        String?
  role               String?
  sector             String?
  category           RecruitmentVendorCategory         @default(OTHER)
  company            String?
  organization       String?
  budget             String?
  salary             String?
  commercialValue    String?
  location           String?
  geography          String?
  country            String?
  experienceText     String?
  minExperience      Int?
  maxExperience      Int?
  eligibility        String?
  qualification      String?
  requirements       String?
  otherDetails       String?
  howToApply         String?
  applicationUrl     String?
  applicationContact String?
  source             String?
  referenceId        String?
  jobId              String?                            @unique
  publishedDate      DateTime?
  expiryDate         DateTime?
  status             RecruitmentVendorOpportunityStatus @default(DRAFT)
  createdBy          String?
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt
  deletedAt          DateTime?

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([location])
  @@index([country])
  @@index([sector])
  @@index([publishedDate])
  @@index([expiryDate])
  @@index([deletedAt])
  @@index([status, category, expiryDate])
}

model RecruitmentVendorPlan {
  id                  String    @id @default(uuid())
  name                String    @unique
  description         String?
  price               Decimal   @db.Decimal(10, 2)
  regularPrice        Decimal   @default(0) @db.Decimal(10, 2)
  discountPercentage  Int       @default(0)
  currency            String    @default("INR")
  durationDays        Int
  isActive            Boolean   @default(true)
  sortOrder           Int       @default(0)
  razorpayPlanId      String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  subscriptions RecruitmentVendorSubscription[]
  couponPlans   RecruitmentVendorCouponPlan[]
  couponUsages  RecruitmentVendorCouponUsage[]

  @@index([isActive])
  @@index([deletedAt])
  @@index([durationDays])
  @@index([razorpayPlanId])
}

model RecruitmentVendorSubscription {
  id                   String             @id @default(uuid())
  userId               String
  planId               String
  startDate            DateTime
  endDate              DateTime
  status               SubscriptionStatus @default(PENDING)
  paymentReference     String?
  razorpaySubscriptionId String?          @unique
  cancelledAt          DateTime?
  cancellationReason   String?
  autoRenew            Boolean            @default(false)
  nextBillingDate      DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        RecruitmentVendorPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments    Payment[]
  couponUsages CouponUsage[]
  rvaCouponUsages RecruitmentVendorCouponUsage[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
  @@index([razorpaySubscriptionId])
  @@index([userId, status, endDate])
  @@index([nextBillingDate])
}

model RecruitmentVendorFaq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([isActive, sortOrder])
  @@index([category])
  @@index([deletedAt])
}

// Optional Recruitment Vendor Access onboarding record. Distinct from any
// existing-vault enrollment: a global User may have at most one RVA
// enrollment, captured separately so the new vault's signups are always
// independently identifiable without duplicating the global account.
model RecruitmentVendorEnrollment {
  id          String    @id @default(uuid())
  userId      String    @unique
  companyName String?
  contactName String?
  vendorType  String?
  source      String?
  status      String    @default("ENROLLED")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([deletedAt])
}

// ==========================================================================
// RECRUITMENT VENDOR ACCESS COUPONS
// ==========================================================================
//
// Deliberately isolated from the Opportunity Vault `Coupon` tables: an RVA
// coupon can only ever target `RecruitmentVendorPlan` rows and only ever
// records `RecruitmentVendorCouponUsage`, so the two vaults can never leak
// discounts or eligibility into each other. The discount math, status
// derivation and error codes are shared with the vault helpers (they are
// pure functions), but no coupon data is shared.

model RecruitmentVendorCoupon {
  id                String              @id @default(uuid())
  code              String              @unique // stored trimmed + upper-cased; lookups are case-insensitive
  description       String?
  discountType      CouponDiscountType
  discountValue     Decimal             @db.Decimal(10, 2)
  validFrom         DateTime
  validUntil        DateTime
  usageLimit        Int? // null = unlimited redemptions
  perUserUsageLimit Int                 @default(1)
  appliesToAllUsers Boolean             @default(true)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  plans  RecruitmentVendorCouponPlan[]
  users  RecruitmentVendorCouponUser[]
  usages RecruitmentVendorCouponUsage[]

  @@index([isActive])
  @@index([deletedAt])
  @@index([validUntil])
}

// Applicable RVA plans. An empty set means the coupon applies to every RVA plan.
model RecruitmentVendorCouponPlan {
  id       String @id @default(uuid())
  couponId String
  planId   String

  coupon RecruitmentVendorCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  plan   RecruitmentVendorPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([couponId, planId])
  @@index([planId])
}

// Allow-list of users for `appliesToAllUsers = false` coupons.
model RecruitmentVendorCouponUser {
  id       String @id @default(uuid())
  couponId String
  userId   String

  coupon RecruitmentVendorCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
}

// One row per redemption. Captures the full server-calculated price
// breakdown plus the purchase/subscription references for auditing.
model RecruitmentVendorCouponUsage {
  id             String   @id @default(uuid())
  couponId       String
  userId         String
  planId         String
  paymentId      String   @unique // one usage per payment session (double-spend guard)
  recruitmentVendorSubscriptionId String?
  originalAmount Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @db.Decimal(12, 2)
  finalAmount    Decimal  @db.Decimal(12, 2)
  currency       String   @default("INR")
  usedAt         DateTime @default(now())

  coupon       RecruitmentVendorCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         RecruitmentVendorPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment      Payment                 @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  recruitmentVendorSubscription RecruitmentVendorSubscription? @relation(fields: [recruitmentVendorSubscriptionId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
  @@index([couponId, userId])
  @@index([planId])
  @@index([recruitmentVendorSubscriptionId])
  @@index([usedAt])
}

// PAYMENTS (Razorpay foundation)
// ==========================================================================

model WebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique // Razorpay event ID (e.g., evt_xxxxx)
  eventType String   // e.g., subscription.charged, payment.failed
  payload   Json     // Full webhook payload for debugging
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([processed])
  @@index([createdAt])
}

model Payment {
  id                     String        @id @default(uuid())
  userId                 String
  subscriptionId         String?
  recruitmentVendorSubscriptionId String?
  razorpayPaymentId      String?       @unique
  razorpayOrderId        String?       @unique
  razorpaySubscriptionId String?
  amount                 Decimal       @db.Decimal(12, 2)
  currency               String        @default("INR")
  status                 PaymentStatus @default(CREATED)
  webhookEvent           String?
  metadata               Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user                        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription                Subscription?              @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  recruitmentVendorSubscription RecruitmentVendorSubscription? @relation(fields: [recruitmentVendorSubscriptionId], references: [id], onDelete: SetNull)
  couponUsages                CouponUsage[]
  recruitmentVendorCouponUsages RecruitmentVendorCouponUsage[]

  @@unique([razorpayOrderId, razorpayPaymentId])
  @@index([userId])
  @@index([subscriptionId])
  @@index([recruitmentVendorSubscriptionId])
  @@index([status])
  @@index([razorpaySubscriptionId])
}

// ==========================================================================
// PUBLIC MARKETING CONTENT — TESTIMONIALS
// ==========================================================================
//
// Subscriber stories rendered on the website homepage. Managed by admins
// (admin/testimonials); the public endpoint only exposes active rows ordered
// by sortOrder.

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String
  badge       String?
  quote       String
  linkedinUrl String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ==========================================================================
// NEWSLETTER SUBSCRIBERS
// ==========================================================================

model NewsletterSubscriber {
  id               String           @id @default(uuid())
  email            String           @unique
  status           NewsletterStatus @default(SUBSCRIBED)
  unsubscribeToken String           @unique
  subscribedAt     DateTime         @default(now())
  unsubscribedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ==========================================================================
// ADMIN AUDIT
// ==========================================================================

model AuditLog {
  id          String   @id @default(uuid())
  adminUserId String?
  userId      String?
  action      String
  entityType  String
  entityId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  adminUser User? @relation("AuditAdminUser", fields: [adminUserId], references: [id], onDelete: SetNull)
  user      User? @relation("AuditActorUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([adminUserId])
  @@index([createdAt])
}
