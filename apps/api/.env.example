# =============================================================================
# Job Search Portal - API environment variables
# Copy this file to .env for local development, or set the same names in
# Railway for production. NEVER commit real secrets.
# =============================================================================

# Server
ENVIRONMENT=production
PORT=5000

# -----------------------------------------------------------------------------
# PostgreSQL (via Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# In Railway, set this to the Postgres plugin's DATABASE_URL (with ?sslmode=require
# or sslmode=no-verify when using the Railway-proxied connection string).
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_portal?schema=public

# -----------------------------------------------------------------------------
# JWT Authentication (paste a strong random secret here)
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Payment is ABSTRACTED in this phase (static/planned only). No real keys required.
# Razorpay keys are intentionally left as placeholders and are NOT used at runtime.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change_me_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=change_me_razorpay_webhook_secret

# -----------------------------------------------------------------------------
# Local File Storage (used for resumes)
# The storage abstraction can be switched to S3/object storage later.
# In the Railway container this is /app/storage (Dockerfile creates it).
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_LOCAL_PUBLIC_URL=https://your-api-railway-url.up.railway.app

# Max upload size in bytes (e.g. 5MB)
MAX_FILE_SIZE=5242880

# -----------------------------------------------------------------------------
# CORS origins allowed to call the API (comma-separated, no spaces)
# In production, set these to the deployed Website and Admin public URLs.
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://website-domain.com,https://admin-domain.com

# In Railway, set this to the deployed Website and Admin public URLs:
#   CORS_ORIGINS=https://website-production-*.up.railway.app,https://admin-production-ae49.up.railway.app
#   (replace with your actual Railway URLs from the dashboard)
