# =============================================================================
# Job Search Portal - API environment variables
# Copy this file to .env and fill in real values. NEVER commit the real .env.
# =============================================================================

# Server
ENVIRONMENT=development
PORT=5000

# -----------------------------------------------------------------------------
# PostgreSQL (via Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_portal?schema=public

# -----------------------------------------------------------------------------
# JWT Authentication (paste a strong random secret here)
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Razorpay (Test Mode for local development)
# Get keys from: https://dashboard.razorpay.com >> Test Mode
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change_me_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=change_me_razorpay_webhook_secret

# -----------------------------------------------------------------------------
# Local File Storage (used for resumes during development)
# The storage abstraction can be switched to S3/object storage later.
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_LOCAL_PUBLIC_URL=http://localhost:5000

# Max upload size in bytes (e.g. 5MB)
MAX_FILE_SIZE=5242880

# -----------------------------------------------------------------------------
# CORS origins allowed to call the API
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
