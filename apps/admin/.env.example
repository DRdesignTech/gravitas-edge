# =============================================================================
# Gravitas Edge Consulting - Admin frontend environment variables
# Copy this file to .env.local for local development.
# In Railway, set these in the Admin service's environment (not committed).
# =============================================================================

# Base URL of the API (without trailing slash). Used by the Next.js server for
# /api rewrites AND inlined into client bundles at build time.
# Local:  http://localhost:5000/api
# Prod:   https://your-api-railway-url.up.railway.app/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# In Railway, set this to the API service URL:
#   NEXT_PUBLIC_API_URL=https://api-production-17b88.up.railway.app/api
#   (replace with your actual Railway API URL from the dashboard)
